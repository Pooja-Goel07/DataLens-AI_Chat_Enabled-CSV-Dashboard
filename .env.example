# Copy this file to `.env` (same directory) for docker-compose.
# The values here feed docker-compose.yml — the backend reads them as environment variables.

# --- Required ---
GOOGLE_API_KEY=your-gemini-api-key
SECRET_KEY=generate-with-"python backend/generate_token.py"

# --- Optional (defaults shown) ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=datalens
LLM_MODEL=gemini-flash-latest
EMBED_MODEL=models/gemini-embedding-001
# The frontend is built with this backend URL (browser-facing):
VITE_API_BASE_URL=http://localhost:8000
